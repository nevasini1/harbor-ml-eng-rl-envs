# Third-party reference clones (harbor, frontier-bench, mle-bench, PostTrainBench,
# RE-Bench and friends). Cloned for research, not authored here.
.research/
_research/

# Virtualenvs and bytecode
**/.venv/
**/__pycache__/
*.pyc

# Regenerable artifacts: research/data is rebuilt by fetch_flip2.py and moleculenet.py
# against pinned checksums, research/cache holds embedding matrices, and research/fixtures
# holds adversarial model checkpoints built by make_fixtures.py.
research/cache/
research/fixtures/

# Exclude the downloaded datasets but keep PINS.json, which is the reproducibility
# contract. Git cannot re-include a file whose parent directory is excluded, so the
# path has to be reopened one level at a time.
research/data/*
!research/data/flip2/
research/data/flip2/*
!research/data/flip2/PINS.json

# Verifier model fixtures for the post-training tasks. The mol task commits its
# base_model because ChemBERTa is 13 MB; distilroberta-base and two copies of
# SmolLM2-135M are 850 MB, which does not belong in git. They are refetched at a
# pinned revision by `python research/posttrain/assemble_tasks.py`, which every task
# tree needs before its verifier image can build.
tasks/pref-reward-model/tests/grader/base_model/
tasks/qa-sft-adapt/tests/grader/base_model/
tasks/qa-sft-adapt/tests/grader/siblings/

# Locked post-training splits and corpora. Both are regenerable and neither is
# the artifact of record: `fetch_data.py` rebuilds the corpora against the sha256
# pins in research/posttrain/data/PINS.json, and `make_splits.py` re-cuts the split
# deterministically from PRIVATE_SEED. What ships -- the agent's training file and
# the held-out rows, anchors and fingerprints -- is copied into each task tree by
# assemble_tasks.py and IS committed there.
research/posttrain/data/*.csv.gz
research/posttrain/split/
research/posttrain/fixtures/

.DS_Store

# Local calibration caches (do not ship embeddings)
tasks/sciml-protein-regression/tests/private_test/calib_emb.npz
tasks/sciml-protein-regression/tests/calibrate_tiers.log

# Submission weights inside post-training job artifacts. A SmolLM2-135M checkpoint
# is ~513 MB, over GitHub's 100 MB per-file limit; the mol and protein tasks' 13-30
# MB checkpoints are small enough to commit and are. What matters from a run is the
# reward, the metrics and the agent log, all of which stay tracked.
jobs/qa-sft-oracle-modal/**/artifacts/**/*.safetensors
jobs/qa-sft-oracle-modal/**/artifacts/**/*.bin
jobs/rm-oracle-modal/**/artifacts/**/*.safetensors
jobs/rm-oracle-modal/**/artifacts/**/*.bin
